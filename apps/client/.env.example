# The only two values the client is ever given. Both are safe to ship in a
# public bundle — the publishable key grants nothing that RLS does not allow.
#
# Never add MODEL_API_KEY or a service-role key here. Anything prefixed VITE_
# is inlined into the JavaScript bundle at build time and is therefore public.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
